// ============================================================================
// ZenFinance — Prisma Schema (Prisma ORM v7, PostgreSQL / Neon)
// Code-first, strict relations, cascading deletes where domain-safe.
// ============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ----------------------------------------------------------------------------
// ENUMS
// ----------------------------------------------------------------------------

enum AccountType {
  CASH
  CARD
  CRYPTO
  SAVINGS
  INVESTMENT
}

enum Currency {
  RUB
  USD
  EUR
  BYN
  USDT
  BTC
  ETH
  GBP
  KZT
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum RecurrenceInterval {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

enum GoalStatus {
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum DebtDirection {
  I_OWE // liability
  OWED_TO_ME // asset
}

enum DebtStatus {
  ACTIVE
  OVERDUE
  SETTLED
}

enum ThemeMode {
  LIGHT
  DARK
  AUTO
}

enum AccentColor {
  INDIGO
  EMERALD
  VIOLET
  AMBER
  ROSE
  CYAN
}

// ----------------------------------------------------------------------------
// USER & SESSION
// ----------------------------------------------------------------------------

model User {
  id           String  @id @default(cuid())
  telegramId   BigInt  @unique
  username     String?
  firstName    String?
  lastName     String?
  languageCode String?
  photoUrl     String?
  isPremium    Boolean @default(false)
  email        String? @unique
  passwordHash String?

  // Preferences
  themeMode    ThemeMode   @default(AUTO)
  accentColor  AccentColor @default(INDIGO)
  baseCurrency Currency    @default(USD)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions      Session[]
  accounts      Account[]
  categories    Category[]
  tags          Tag[]
  transactions  Transaction[]
  subscriptions Subscription[]
  budgets       Budget[]
  goals         Goal[]
  debts         Debt[]
  templates     Template[]
  contacts      Contact[]

  @@index([telegramId])
  @@map("users")
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String   @unique // hashed session token, never store raw
  initDataHash String // hash of validated initData payload for audit
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

// ----------------------------------------------------------------------------
// ACCOUNTS
// ----------------------------------------------------------------------------

model Account {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  debts Debt[]

  name       String
  type       AccountType
  currency   Currency
  balance    Decimal     @default(0) @db.Decimal(20, 8) // 8dp precision for crypto
  isArchived Boolean     @default(false)

  // Visual presets
  colorGradientStart String? // hex
  colorGradientEnd   String? // hex
  iconKey            String? // lucide icon key or custom asset key
  maskedNumber       String? // e.g. "**** 4242" — never store full PAN

  // Monthly spend limit / warning threshold
  monthlyLimit    Decimal? @db.Decimal(20, 8)
  limitWarningPct Int?     @default(80) // percent threshold to trigger warning

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactionsFrom Transaction[]  @relation("FromAccount")
  transactionsTo   Transaction[]  @relation("ToAccount")
  subscriptions    Subscription[]
  goals            Goal[]
  templates        Template[]

  @@index([userId])
  @@map("accounts")
}

// ----------------------------------------------------------------------------
// CATEGORIES & TAGS
// ----------------------------------------------------------------------------

model Category {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name     String
  type     TransactionType // INCOME or EXPENSE (categories aren't used for TRANSFER)
  iconKey  String
  colorHex String

  parentId String?
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children Category[] @relation("CategoryHierarchy")

  isSystem  Boolean  @default(false) // seeded default categories
  createdAt DateTime @default(now())

  transactions Transaction[]
  budgets      Budget[]
  templates    Template[]

  @@index([userId])
  @@index([parentId])
  @@map("categories")
}

model Tag {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  colorHex  String?
  createdAt DateTime @default(now())

  transactions TransactionTag[]

  @@unique([userId, name])
  @@map("tags")
}

// Explicit join model (many-to-many with metadata room for future use)
model TransactionTag {
  transactionId String
  tagId         String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  tag           Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([transactionId, tagId])
  @@map("transaction_tags")
}

// ----------------------------------------------------------------------------
// TRANSACTIONS
// ----------------------------------------------------------------------------

model Transaction {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type     TransactionType
  amount   Decimal         @db.Decimal(20, 8) // in fromAccount's currency
  currency Currency

  // For TRANSFER: fromAccount debited, toAccount credited (with conversion)
  fromAccountId String?
  fromAccount   Account? @relation("FromAccount", fields: [fromAccountId], references: [id], onDelete: SetNull)
  toAccountId   String?
  toAccount     Account? @relation("ToAccount", fields: [toAccountId], references: [id], onDelete: SetNull)
  exchangeRate  Decimal? @db.Decimal(20, 8) // applied rate for TRANSFER conversions

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  description String?
  occurredAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptionId String? // set if generated by a recurring subscription run
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  debtId String? // set if this is a repayment against a Debt
  debt   Debt?   @relation(fields: [debtId], references: [id], onDelete: SetNull)

  tags TransactionTag[]

  @@index([userId, occurredAt])
  @@index([fromAccountId])
  @@index([toAccountId])
  @@index([categoryId])
  @@map("transactions")
}

// ----------------------------------------------------------------------------
// RECURRING / SUBSCRIPTIONS
// ----------------------------------------------------------------------------

model Subscription {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name     String
  type     TransactionType // INCOME (salary) or EXPENSE (bill)
  amount   Decimal         @db.Decimal(20, 8)
  currency Currency

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  interval  RecurrenceInterval
  nextRunAt DateTime
  lastRunAt DateTime?
  status    SubscriptionStatus @default(ACTIVE)

  reminderDaysBefore Int? @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]

  @@index([userId, nextRunAt])
  @@index([status, nextRunAt]) // fast lookup for the cron sweep
  @@map("subscriptions")
}

// ----------------------------------------------------------------------------
// BUDGETS
// ----------------------------------------------------------------------------

model Budget {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name       String
  categoryId String? // null = overall monthly budget
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  limitAmount Decimal  @db.Decimal(20, 8)
  currency    Currency
  periodStart DateTime // first day of the budget period
  periodEnd   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, periodStart, periodEnd])
  @@map("budgets")
}

// ----------------------------------------------------------------------------
// GOALS & PIGGY BANK
// ----------------------------------------------------------------------------

model Goal {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name          String
  targetAmount  Decimal    @db.Decimal(20, 8)
  currentAmount Decimal    @default(0) @db.Decimal(20, 8)
  currency      Currency
  targetDate    DateTime?
  status        GoalStatus @default(IN_PROGRESS)

  // Piggy bank round-up rule
  roundUpEnabled   Boolean  @default(false)
  roundUpAccountId String?
  roundUpAccount   Account? @relation(fields: [roundUpAccountId], references: [id], onDelete: SetNull)
  roundUpToNearest Decimal? @db.Decimal(10, 2) // e.g. round up to nearest 10.00

  iconKey   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deposits GoalDeposit[]

  @@index([userId, status])
  @@map("goals")
}

model GoalDeposit {
  id        String   @id @default(cuid())
  goalId    String
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  amount    Decimal  @db.Decimal(20, 8)
  note      String?
  createdAt DateTime @default(now())

  @@index([goalId])
  @@map("goal_deposits")
}

// ----------------------------------------------------------------------------
// DEBTS & CONTACTS
// ----------------------------------------------------------------------------

model Contact {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  telegramUsername String?
  phone            String?
  createdAt        DateTime @default(now())

  debts Debt[]

  @@index([userId])
  @@map("contacts")
}

model Debt {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  direction DebtDirection
  contactId String?
  contact   Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)

  principal Decimal    @db.Decimal(20, 8)
  remaining Decimal    @db.Decimal(20, 8)
  currency  Currency
  dueDate   DateTime?
  status    DebtStatus @default(ACTIVE)
  note      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  repayments Transaction[] // transactions with debtId set

  @@index([userId, status])
  @@map("debts")
}

// ----------------------------------------------------------------------------
// TEMPLATES (Quick Actions)
// ----------------------------------------------------------------------------

model Template {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  label      String // e.g. "Morning Coffee"
  type       TransactionType
  amount     Decimal         @db.Decimal(20, 8)
  currency   Currency
  accountId  String?
  account    Account?        @relation(fields: [accountId], references: [id], onDelete: SetNull)
  categoryId String?
  category   Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  iconKey    String?
  sortOrder  Int             @default(0)

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("templates")
}
